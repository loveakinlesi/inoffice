{
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!_vercel/|assets/|api/).*)", "destination": "/index.html" }
  ]
}
